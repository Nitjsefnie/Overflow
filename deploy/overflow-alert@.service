# Overflow failure alerts.
#
# A template unit that mails the tail of a failed unit's journal to the
# address in /etc/overflow/alert-recipient. Triggered only by OnFailure= from
# overflow.service and overflow-backup.service; never enabled. Install as
# /etc/systemd/system/overflow-alert@.service. The recipient file is host
# configuration read at run time: it is never committed and never referenced
# by value in this repository.
#
# Mail goes out by SMTP to the local exim daemon (smtp://127.0.0.1:25) with
# curl, because invoking exim in-process needs the setgroups() privilege dance
# that the empty capability bounding set deliberately removes.

[Unit]
Description=Email the failure log of %i

[Service]
Type=oneshot

# The unit's timeout has to be stated here because the host does not state it:
# this oneshot inherits systemd's DefaultTimeoutStartSec, and this host's is
# commented out in /etc/systemd/system.conf, so the inherited default is 90s.
# The script's own worst case is ABOVE that, not equal to it: its submission
# carries a 30s --max-time, and the verdict poll then spends up to 60s checking
# once a second, with the deadline tested before each wait rather than after,
# so the final iteration overshoots by a wait plus a spawn. 90s is therefore not
# a ceiling the script respects. Spending the whole budget is also not an
# unlucky case: a greylisted relay, or one that is down, does it every time. A
# oneshot killed at its timeout gives the operator a `failed` unit and NEITHER
# line the script would have written: not the delivery it would have reported,
# and not the failed delivery it would have reported instead. 120s leaves the
# script's own bound as the thing that decides the outcome.
TimeoutStartSec=120s

# Runs as root, like the backup unit: the recipient file is root-only and is
# read by the script at run time, not by systemd. The PATH carries no
# component under /root, and curl speaks to the local exim daemon.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStart=/bin/sh /srv/overflow/scripts/overflow-alert.sh %i

# Any file the alert run creates is root-private.
UMask=0077

# No privilege elevation, no capabilities: the unit reads one root-only file
# and hands one message to the local mail daemon over SMTP, and nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# One supplementary group, and it is load-bearing rather than tidiness. The
# script follows the accepted message id into /var/log/exim4/mainlog and reads
# the transport off the routing line there, because a submission the daemon
# merely spooled is not an alert that arrived. That file is 0640 Debian-exim:adm
# in a 2750 Debian-exim:adm directory.
#
# ProtectSystem=strict does not grant that read - it governs the mount
# namespace, not file access. The empty CapabilityBoundingSet above is what
# does: root then holds no CAP_DAC_OVERRIDE and no CAP_DAC_READ_SEARCH, and
# root's own groups are not adm's, so open() is refused. Measured on this host:
# the same file is unreadable under `capsh --drop=all` and readable under
# `capsh --drop=all` with this group. The canary unit reads the same log the
# same way and carries the same directive.
#
# Without it every alert waits out its whole verdict budget, reports that it
# did not leave this host, exits nonzero, and writes no throttle state - so a
# unit cycling slower than the start limit mails once per cycle instead of once
# per 30 minutes, and reports each one as failed.
SupplementaryGroups=adm

# The whole filesystem is read-only except the one directory the throttle
# state needs: RuntimeDirectory= stands up /run/overflow-alert for each run
# and grants it implicitly (ReadWritePaths= stays out), and
# RuntimeDirectoryPreserve=yes keeps the directory, and the recorded send
# times in it, across runs of this oneshot (wiped at reboot). The exim daemon
# spools the submission in its own namespace, outside this sandbox. Home
# directories are unreachable and /tmp and /dev are private.
ProtectSystem=strict
RuntimeDirectory=overflow-alert
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

# The host itself is off limits, as in overflow.service. ProcSubset= is
# deliberately not set: journalctl reads /proc/sys/kernel/random/boot_id,
# which ProcSubset=pid hides.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# May speak IP and local sockets, on this architecture only, with the same
# EPERM-instead-of-kill seccomp posture as the web service.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=overflow-alert
