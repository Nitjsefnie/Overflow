# Auth.js signs sessions; generate with `npx auth secret`.
AUTH_SECRET=

# GitHub OAuth application credentials.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 32 random bytes encoded as unpadded base64url for AES-256-GCM OAuth token encryption.
TOKEN_ENCRYPTION_KEY=

# Comma-separated GitHub logins granted the moderator role at sign-in.
MODERATOR_GITHUB_LOGINS=

# PostgreSQL and GitHub webhook delivery configuration.
DATABASE_URL=postgresql://overflow:overflow@localhost:5432/overflow
GITHUB_WEBHOOK_URL=https://example.com/api/webhooks/github
GITHUB_WEBHOOK_SECRET=
